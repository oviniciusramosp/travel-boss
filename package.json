{
  "name": "travel-boss",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "travel:areas": "python3 scripts/fetch-travel-polygons.py",
    "travel:areas:force": "python3 scripts/fetch-travel-polygons.py --force",
    "travel:areas:check": "vitest run src/data/travel-areas.test.ts",
    "travel:notion:pull": "node scripts/sync-travel-notion.mjs pull",
    "travel:notion:push": "node scripts/sync-travel-notion.mjs push",
    "travel:notion:schema": "node scripts/sync-travel-notion.mjs schema",
    "travel:notion:sync": "node scripts/sync-travel-notion.mjs sync",
    "travel:notion:seed": "node scripts/sync-travel-notion.mjs seed",
    "travel:notion:seed:paris": "node scripts/sync-travel-notion.mjs seed src/data/paris-seed-dump.json",
    "travel:notion:migrate": "node scripts/sync-travel-notion.mjs migrate",
    "travel:notion:placeids": "node scripts/sync-travel-notion.mjs placeids",
    "travel:notion:seed-subcategories": "node scripts/sync-travel-notion.mjs seed-subcategories",
    "travel:notion:seed-photos": "node scripts/sync-travel-notion.mjs seed-photos",
    "travel:airbnb:setup": "uv venv --allow-existing node_modules/.cache/airbnb-venv && uv pip install --python node_modules/.cache/airbnb-venv/bin/python -r scripts/airbnb-requirements.txt"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
