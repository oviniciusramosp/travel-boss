{
  "name": "travel-boss",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "travel:videos:sync": "node scripts/sync-travel-videos.mjs",
    "travel:areas": "python3 scripts/fetch-travel-polygons.py",
    "travel:areas:force": "python3 scripts/fetch-travel-polygons.py --force",
    "travel:amenities": "NODE_OPTIONS=--dns-result-order=ipv4first vite-node scripts/fetch-amenities.ts",
    "travel:areas:check": "vitest run src/data/travel-areas.test.ts",
    "travel:photos:check": "python3 scripts/check-travel-photos.py",
    "travel:locations:check": "vite-node scripts/check-travel-locations.ts",
    "travel:airbnb:setup": "uv venv --allow-existing node_modules/.cache/airbnb-venv && uv pip install --python node_modules/.cache/airbnb-venv/bin/python -r scripts/airbnb-requirements.txt"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/lekton": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
