# Copy to .env and fill in. .env is gitignored. Do not commit values.
# Names only — no defaults pasted here.
#
# Notion sync (scripts/sync-travel-notion.mjs):
#   NOTION_TOKEN            required
#   NOTION_DATABASE_ID      optional; the script has its own default
#   GOOGLE_MAPS_API_KEY     optional; bulk-fill Google Place IDs
#   GOOGLE_API_KEY          optional alias of GOOGLE_MAPS_API_KEY
# Hotel search (scripts/hotel-search.mjs), not used by the Notion sync:
#   TYPESAFE_API_KEY
NOTION_TOKEN=
NOTION_DATABASE_ID=
GOOGLE_MAPS_API_KEY=
GOOGLE_API_KEY=
TYPESAFE_API_KEY=
